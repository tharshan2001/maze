<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="turtlebot3_burger">

  <!-- ===================== Parameters ===================== -->
  <xacro:property name="base_radius" value="0.105"/>
  <xacro:property name="base_height" value="0.14"/>
  <xacro:property name="wheel_radius" value="0.033"/>
  <xacro:property name="wheel_width"  value="0.018"/>
  <xacro:property name="wheel_separation" value="0.160"/>
  <xacro:property name="caster_radius" value="0.010"/>

  <!-- ===================== Materials ===================== -->
  <material name="black">  <color rgba="0.1 0.1 0.1 1"/></material>
  <material name="grey">   <color rgba="0.4 0.4 0.4 1"/></material>
  <material name="red">    <color rgba="0.8 0.1 0.1 1"/></material>

  <!-- ===================== base_footprint ===================== -->
  <link name="base_footprint"/>

  <!-- base_link sits at the wheel-axle height (one wheel radius above the
       ground) so the two drive wheels make contact. The body cylinder is
       shifted up so it does not drag on the floor. -->
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- ===================== base_link ===================== -->
  <link name="base_link">
    <inertial>
      <mass value="0.8"/>
      <!-- CoM slightly behind the drive axle so it stays inside the
           2-wheel + rear-caster support triangle (prevents nose-diving). -->
      <origin xyz="-0.04 0 ${base_height/2}"/>
      <inertia ixx="0.0016" ixy="0" ixz="0"
               iyy="0.0016" iyz="0" izz="0.0030"/>
    </inertial>
    <visual>
      <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="${base_radius}" length="${base_height}"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="${base_radius}" length="${base_height}"/></geometry>
    </collision>
  </link>

  <!-- ===================== Wheels (macro) ===================== -->
  <xacro:macro name="wheel" params="prefix y">
    <link name="wheel_${prefix}_link">
      <inertial>
        <mass value="0.05"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="0.00001" ixy="0" ixz="0"
                 iyy="0.00001" iyz="0" izz="0.00001"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
    </link>

    <joint name="wheel_${prefix}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="wheel_${prefix}_link"/>
      <origin xyz="0 ${y} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.01" friction="0.0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel prefix="left"  y="${wheel_separation/2}"/>
  <xacro:wheel prefix="right" y="-${wheel_separation/2}"/>

  <!-- ===================== Caster ===================== -->
  <link name="caster_back_link">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.000001" ixy="0" ixz="0"
               iyy="0.000001" iyz="0" izz="0.000001"/>
    </inertial>
    <visual>
      <geometry><sphere radius="${caster_radius}"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry><sphere radius="${caster_radius}"/></geometry>
    </collision>
  </link>

  <joint name="caster_back_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_back_link"/>
    <!-- Ball centre sits one caster-radius above the floor; placed further
         back to widen the support triangle. -->
    <origin xyz="-0.09 0 ${caster_radius - wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- ===================== 2D LiDAR (LDS-01) ===================== -->
  <link name="scan">
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0" ixz="0"
               iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
    <visual>
      <geometry><cylinder radius="0.03" length="0.04"/></geometry>
      <material name="red"/>
    </visual>
  </link>

  <joint name="scan_joint" type="fixed">
    <parent link="base_link"/>
    <child link="scan"/>
    <!-- On top of the body cylinder (which is centred at base_height/2). -->
    <origin xyz="0 0 ${base_height + 0.02}" rpy="0 0 0"/>
  </joint>

  <!-- ===================== Gazebo / gz sim plugins ===================== -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>wheel_left_joint</left_joint>
      <right_joint>wheel_right_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <min_linear_acceleration>-1.0</min_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
      <min_angular_acceleration>-2.0</min_angular_acceleration>
      <max_linear_velocity>0.22</max_linear_velocity>
      <min_linear_velocity>-0.22</min_linear_velocity>
      <max_angular_velocity>2.84</max_angular_velocity>
      <min_angular_velocity>-2.84</min_angular_velocity>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>
  </gazebo>

  <!-- High friction on the drive wheels so they grip instead of slipping;
       the caster is nearly frictionless so it slides rather than resisting.
       Good traction keeps wheel odometry (and therefore AMCL) honest. -->
  <gazebo reference="wheel_left_link">
    <mu1>1.5</mu1>
    <mu2>1.5</mu2>
    <kp>1000000</kp>
    <kd>100</kd>
  </gazebo>
  <gazebo reference="wheel_right_link">
    <mu1>1.5</mu1>
    <mu2>1.5</mu2>
    <kp>1000000</kp>
    <kd>100</kd>
  </gazebo>
  <gazebo reference="caster_back_link">
    <mu1>0.01</mu1>
    <mu2>0.01</mu2>
  </gazebo>

  <!-- gz sim only supports GPU LIDAR. The world includes the Sensors system and
       the server is launched in headless-rendering mode so it works without a
       display (software Mesa/llvmpipe is used when no GPU is available). -->
  <gazebo reference="scan">
    <sensor name="lidar" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <topic>scan</topic>
      <gz_frame_id>scan</gz_frame_id>
      <update_rate>10</update_rate>
      <visualize>false</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>3.5</max>
          <resolution>0.015</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
      <always_on>1</always_on>
    </sensor>
  </gazebo>

</robot>
